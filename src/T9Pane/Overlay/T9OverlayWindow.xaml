<local:NoActivateWindow x:Class="T9Pane.Overlay.T9OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:T9Pane.Overlay"
        Title="T9 九键"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        Width="400"
        Height="404"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="FrameBrush" Color="#FFF4F6F9"/>
        <SolidColorBrush x:Key="PaneBrush" Color="#FFF4F6F9"/>
        <SolidColorBrush x:Key="FrameEdgeBrush" Color="#FFD6DCE5"/>
        <SolidColorBrush x:Key="KeyBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="FunctionKeyBrush" Color="#FFE4E9F0"/>
        <SolidColorBrush x:Key="KeyEdgeBrush" Color="#FFD8DEE7"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FF20242A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6F7783"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563D9"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1F58C5"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFDDE9FF"/>
        <SolidColorBrush x:Key="TabOnBrush" Color="#FFDDE9FF"/>
        <SolidColorBrush x:Key="CandidateBrush" Color="#FFFDFEFF"/>
        <SolidColorBrush x:Key="CandidateEdgeBrush" Color="#FFE0E5EC"/>

        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KeyBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource KeyEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="3,3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="KeyScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.09">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.09">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionKeyButton"
               TargetType="Button"
               BasedOn="{StaticResource KeyButton}">
            <Setter Property="Background" Value="{StaticResource FunctionKeyBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FunctionKeyBrush}"/>
            <Setter Property="Foreground" Value="#FF343A43"/>
        </Style>

        <Style x:Key="FullKeyButton"
               TargetType="Button"
               BasedOn="{StaticResource KeyButton}">
            <Setter Property="Margin" Value="2.5,2.5"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="PrimaryKeyButton"
               TargetType="Button"
               BasedOn="{StaticResource KeyButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="CandidateButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="KeyScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="KeyScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="{x:Static local:TouchKeyVisual.PressScale}" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FrameBorder"
            Background="{StaticResource FrameBrush}"
            BorderBrush="{StaticResource FrameEdgeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8"
            ClipToBounds="True">
        <Grid x:Name="ChromeGrid" ClipToBounds="True">
            <Image x:Name="SkinImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>
            <Grid x:Name="PaneGrid"
                  Background="{StaticResource PaneBrush}"
                  ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="FunctionRow" Height="52"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DragButton"
                        Style="{StaticResource TabButton}"
                        Content="⠿"
                        MinWidth="32"
                        Padding="6,5"
                        Foreground="{StaticResource MutedBrush}"
                        HorizontalContentAlignment="Center"
                        Cursor="SizeAll"
                        ToolTip="拖动键盘"
                        PreviewMouseLeftButtonDown="OnDragHandleDown"/>
                <Button x:Name="PinButton"
                        Grid.Column="1"
                        Style="{StaticResource TabButton}"
                        MinWidth="32"
                        Padding="6,5"
                        ToolTip="锁定键盘"
                        Click="OnPinClicked"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            ClipToBounds="True">
                    <Button x:Name="PinyinTab"
                            Style="{StaticResource TabButton}"
                            Padding="6,5"
                            Content="拼音"
                            Click="OnPinyinTab"/>
                    <Button x:Name="Pinyin26Tab"
                            Style="{StaticResource TabButton}"
                            Padding="6,5"
                            Content="26键"
                            ToolTip="拼音26键"
                            Click="OnPinyin26Tab"/>
                    <Button x:Name="EnglishTab"
                            Style="{StaticResource TabButton}"
                            Padding="6,5"
                            Content="英文"
                            Click="OnEnglishTab"/>
                    <Button x:Name="FullTab"
                            Style="{StaticResource TabButton}"
                            Padding="6,5"
                            Content="全键"
                            Click="OnFullTab"/>
                    <Button x:Name="DigitTab"
                            Style="{StaticResource TabButton}"
                            Padding="6,5"
                            Content="数字"
                            Click="OnDigitModeClicked"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Style="{StaticResource TabButton}"
                        Content="×"
                        FontSize="18"
                        Padding="0"
                        Margin="0"
                        MinWidth="36"
                        Foreground="{StaticResource MutedBrush}"
                        ToolTip="关闭"
                        Click="OnCloseClicked"/>
            </Grid>

            <Border x:Name="CandidateBar"
                    Grid.Row="1"
                    Margin="0,1,0,1"
                    Background="{StaticResource CandidateBrush}"
                    BorderBrush="{StaticResource CandidateEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Cursor="Arrow">
                <Grid Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="7"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="CodeText"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Width="84"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border Grid.Column="1"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            Height="28">
                        <ScrollViewer x:Name="CandidateScroller"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="None"
                                      CanContentScroll="False"
                                      ClipToBounds="True">
                            <StackPanel x:Name="CandidatePanel"
                                        Orientation="Horizontal"
                                        Height="28"/>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="CandidateMore"
                            Grid.Column="2"
                            Style="{StaticResource CandidateButton}"
                            Width="32"
                            Margin="2,0,0,0"
                            FontSize="16"
                            ToolTip="展开候选"
                            Visibility="Collapsed"
                            Click="OnCandidateMore"/>
                </Grid>
            </Border>

            <Grid x:Name="BoardHost"
                  Grid.Row="2"
                  ClipToBounds="True"/>

            <Grid x:Name="FunctionBar" Grid.Row="3" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="2.7*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LangButton"
                        Style="{StaticResource FunctionKeyButton}"
                        Content="中 / EN"
                        FontSize="14"/>
                <Button x:Name="SpaceButton"
                        Grid.Column="1"
                        Style="{StaticResource KeyButton}"
                        Content="空格"
                        FontSize="14"
                        FontWeight="Normal"/>
                <Button x:Name="DigitButton"
                        Grid.Column="2"
                        Style="{StaticResource FunctionKeyButton}"
                        Content="123"
                        FontSize="14"/>
                <Button x:Name="EnterButton"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryKeyButton}"
                        FontSize="14"
                        ToolTip="回车"/>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</local:NoActivateWindow>
